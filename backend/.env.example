# Backend environment variables
# Copy this file to .env and fill in your values

# CORS origins (comma-separated, no spaces)
# Set this to your Vercel frontend URL
CORS_ORIGINS=http://localhost:5173

# Server port (Render sets this automatically)
PORT=3000

# HTTPS mode (only needed if running your own reverse proxy)
USE_HTTPS=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# TURN server for WebRTC (optional, improves P2P connectivity)
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CREDENTIAL=
